<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <InterceptorsPreviewNamespaces>$(InterceptorsPreviewNamespaces);Microsoft.Extensions.Configuration.Binder.SourceGeneration</InterceptorsPreviewNamespaces>
    <ApplicationIcon>Assets/favicon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ManagedNativeWifi" Version="3.1.0" />
    <PackageReference Include="System.Management" Version="11.0.0" />
    <PackageReference Include="chd.UI.Base.WPF" Version="2.0.26316.221" />
    <PackageReference Include="System.Speech" Version="11.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Assets\" />
    <Resource Include="Assets/favicon.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\chdScoring.App.UI\chdScoring.App.UI.csproj" />
  </ItemGroup>

</Project>
