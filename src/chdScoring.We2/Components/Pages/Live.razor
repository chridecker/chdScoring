@page "/live"
@using chdScoring.Contracts.Dtos
@using chdScoring.Contracts.Interfaces
@using chdScoring.Web.Components.Pages.Base
@using chdScoring.Web.Services
@using chd.UI.Base.Contracts.Enum
@inherits HubPage

<PageTitle>Live</PageTitle>

@if (this._dto?.Pilot is not null)
{
    <div class="control-center">
        <div class="pilot-data">
            <div class="country">
                @if (this._countryImg is not null && this._countryImg.Data.Length > 0)
                {
                    <CustomImage Class="pilot-image" Data="this._countryImg.Data" Type="@this._countryImg.Type" />
                }
            </div>
            <div class="name">
                @this._dto.Pilot.Id - @this._dto.Pilot.Name
            </div>
            <div class="left-time">@_leftTime</div>
        </div>
        <div class="maneouvres" style="--judge-count: @this._dto.Judges.Count()">
            @foreach (var maneouvre in this._dto.ManeouvreLst.FirstOrDefault().Value.OrderBy(o => o.Id))
            {
                <div class="maneouvre">
                    <div class="figur-id">@maneouvre.Id.ToString("D2")</div>
                    <div class="figur">@maneouvre.Name (@maneouvre.Value)</div>
                    <div class="judge-scores">
                        @foreach (var judge in this._dto.Judges.OrderBy(o => o.Id))
                        {
                            <div class="judge-score ">
                                @if (this._maneouvre(judge, maneouvre)?.Score.HasValue ?? false)
                                {
                                    <div class="score-total">
                                        @_scoreTotal(judge, maneouvre)
                                    </div>
                                    <div class="score-raw">@((_score(judge, maneouvre) ?? 0).ToString("0.#"))</div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="pause-container">
        <CustomIcon FAClass="circle-pause" Style="EIconStyle.Regular" />
    </div>
}

@code {
    private decimal? _score(JudgeDto judge, ManeouvreDto maneouvre) => this._maneouvre(judge, maneouvre)?.Score;
    private decimal? _scoreTotal(JudgeDto judge, ManeouvreDto maneouvre) => this._maneouvre(judge, maneouvre)?.Score * maneouvre.Value;
    private ManeouvreDto _maneouvre(JudgeDto judge, ManeouvreDto maneouvre) => this._dto.ManeouvreLst[judge.Id].FirstOrDefault(x => x.Id == maneouvre.Id);
}
