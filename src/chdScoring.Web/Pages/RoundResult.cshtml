@page
@model chdScoring.Web.Pages.RoundResultModel
@{
}

<table>
    <tr>
        <th colspan="@Model.Data.Judges.Count()+2" class="headline" style="text-align:left; vertical-align:bottom;">
            Scoring Table @Model.Stammdaten.TournamentName (@Model.Stammdaten.From.ToString("dd.MM.yy") - @Model.Stammdaten.To.ToString("dd.MM.yy"))
        </th>
        <th colspan="2"><img src="@Model.Logo.Src" /></th>
    </tr>
    <tr class="teilnehmer">
        <th colspan="3">Pilot</th>
        <th colspan="2">FAI - License</th>
        <th colspan="2">Flight duration</th>
        <th colspan="100">Round</th>
    </tr>
    <tr class="teilnehmer">
        <td># @Model.Data.Pilot.Id</td>
        <td colspan="2">
            @Model.Data.Pilot.Name / @Model.Data.Pilot.Club / @Model.Data.Pilot.CountryCode
        </td>
        <td colspan="2">@Model.Data.Pilot.License</td>
        <td colspan="2">@Model.Data.Round.Time.Minutes.ToString("D2"):@Model.Data.Round.Time.Seconds.ToString("D2")</td>
        <td colspan="3">R @Model.Data.Round.Id / @Model.Data.Round.Program</td>
    </tr>
    <tr class="header">
        <th class="figur">&#8470;</th>
        <th class="figur">Manoeuvre</th>
        <th class="figur" style="text-align:center;">K</th>
        @if (@Model.Data.Judges.Count() == 1)
        {
            <th class="judge"></th>
            <th class="judge"></th>
            <th class="judge"></th>
        }
        @foreach (var judge in Model.Data.Judges.OrderBy(o => o.Id))
        {
            <th class="judge">
                Judge @judge.Id
            </th>
        }
        <th class="judge">Total</th>
    </tr>
    @foreach (var (figur, i) in Model.Data.ManeouvreLst.Values.FirstOrDefault().Select((s, i) => (s, i)))
    {
        <tr class="@(i % 2 == 0 ? "gerade" : string.Empty)">
            <td>@figur.Id.ToString("D2")</td>
            <td class="figur">@figur.Name</td>
            <td style="text-align:center;">@figur.Value</td>
            @if (Model.Data.Judges.Count() == 1)
            {
                <td colspan="3"></td>
            }
            @foreach (var score in Model.Data.ManeouvreLst)
            {
                <td align="center" style="">
                    @if (score.Value.FirstOrDefault(x => x.Id == figur.Id).Score < 0)
                    {
                        <text>NO</text>
                    }
                    else
                    {
                        @((score.Value.FirstOrDefault(x => x.Id == figur.Id).Score ?? 0).ToString("#.####"))
                    }
                </td>
            }
            <td align='center'>@Model.Data.ManeouvreLst.Values.SelectMany(s => s).Where(x => x.Id == figur.Id).Select(s => (s.Score ?? 0) * s.Value).Sum().ToString("#.####")</td>
        </tr>
    }
    <tr class="gesamt">
        <th colspan="3"></th>
        @if (Model.Data.Judges.Count() == 1)
        {
            <td colspan='3'></td>
        }
        @foreach (var judge in Model.Data.Judges)
        {
            <td style="text-align: center; padding-bottom: 0.1cm;">
                @Model.JudgeResult(judge.Id) (@((1-(Model.JudgeResult(judge.Id) / Model.RoundResult) * -100 ).ToString("#.##"))%)<br />
                @judge.Name
            </td>
        }

        <th>@Model.RoundResult.ToString("#.####")</th>
    </tr>
    <tr class="footer">
        <td>@DateTime.Now.ToString("dd.MM.yy HH:mm")</td>
        <td colspan="@(Model.Data.Judges.Count() == 1 ? 7 : Model.Data.Judges.Count() + 3)">
            chdScoring 3.0 &copy; @DateTime.Now.Year
        </td>
    </tr>
</table>