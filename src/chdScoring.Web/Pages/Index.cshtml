@page
@using chd.UI.Base.Contracts.Enum
@using chdScoring.Web.Models
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div id="timer-container">
</div>

<dialog id="error-dialog">
    <p id="error-dialog-content"></p>
</dialog>

@section Scripts {
    <script>

        var hubUrl = '@this.Model.HubClientUrl';
        var render = '@this.Model.RenderSetting';
        var mode= '@this.Model.Mode';

        const connection = new signalR.HubConnectionBuilder()
             .withUrl(hubUrl)
             .build();

        connection.onclose(async () => {
            await startHubConnection(connection);
        });

        // Start the connection.
        startHubConnection(connection);

    </script>
}
