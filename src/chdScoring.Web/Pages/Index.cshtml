@page
@using chd.UI.Base.Contracts.Enum
@using chdScoring.Web.Models
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div id="timer-container">
</div>

<dialog id="error-dialog">
    <p id="error-dialog-content"></p>
</dialog>

@section Scripts {
    <script>

        var flightHubUrl = '@this.Model.FlightHubClientUrl';
        var deviceHubUrl = '@this.Model.DeviceHubClientUrl';
        var apiKey = '@this.Model.ApiKey';
        var name = '@this.Model.Name';
        var render = '@this.Model.RenderSetting';
        var mode= '@this.Model.Mode';

        const connection = new signalR.HubConnectionBuilder()
            .withUrl(flightHubUrl, {
               accessTokenFactory: ()=>  apiKey,
                transport: signalR.HttpTransportType.WebSockets
            })
             .build();

        connection.onclose(async () => {
            await startHubConnection(connection);
        });
        
        const deviceConnection = new signalR.HubConnectionBuilder()
            .withUrl(deviceHubUrl, {
               accessTokenFactory: ()=>  apiKey,
                transport: signalR.HttpTransportType.WebSockets
            })
             .build();

        deviceConnection.onclose(async () => {
            await startDeviceHubConnection(deviceConnection, apiKey, name);
        });

        // Start the connection.
        startHubConnection(connection);
        startDeviceHubConnection(deviceConnection, apiKey, name);

    </script>
}
