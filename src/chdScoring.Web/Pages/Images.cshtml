@page
@model chdScoring.Web.Pages.ImagesModel
@{
}
<div class="image-container">
    <h1>Wir danken unseren Sponsoren</h1>
    <img src="" />
</div>

@section Scripts {
    <script>

            const imageUrls = [];
        @foreach (var imgUrl in this.Model.ImageUrls)
            {
                                            <text>
                                                                                imageUrls.push('@(imgUrl)');
                                                </text>

            }
            const imgElement = document.querySelector('.image-container img');

            

            changeImage(0);
            var index = 0;

            // Alle 5 Sekunden wechseln
            setInterval(() => {
                 index = (index + 1) % imageUrls.length;
                changeImage(index);
            }, @this.Model.Interval);

            function changeImage(index) {
               imgElement.classList.remove("fade-in");

                 fetch('?handler=Base64&file=' + imageUrls[index])
                 .then(r => {
                     r.text().then(t => {
                        imgElement.src = 'data:image/png;base64,' + t;
                        imgElement.classList.add("fade-in");
                     });
                 })
            }
    </script>
}