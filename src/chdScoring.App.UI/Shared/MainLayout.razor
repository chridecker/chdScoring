@inherits PageComponentBase<int,int>
@using Blazored.Toast.Configuration
@using chd.UI.Base.Client.Implementations.Services
@using chd.UI.Base.Contracts.Enum
@inject ISettingManager clientSettings
@inject IScrollInfoService scrollInfoService
@inject IchdScoringProfileService profileService
@inject IDeviceHubClient deviceHubClient
@inject IAppInfoService appInfoService
@inject NavigationManager _navManager
@implements IDisposable

<div class="page @(this.clientSettings.IsiOS ? "ios" : "")">
    <NavMenu Visible="true" />

    <main>
        <div class="top-row">
            <Header PageTitle="@this.Title"></Header>
        </div>
        <article id="main-article" class="content px-4" @onscroll="scrollInfoService.Scrolled">
            @Body
        </article>
    </main>
</div>

<BlazoredToasts Position="ToastPosition.BottomRight"
                Timeout="5"
                MaxToastCount="3"
                RemoveToastsOnNavigation="true"
                ShowProgressBar="true">
    <CloseButtonContent>
        <div>
            <span>&times;</span>
        </div>
    </CloseButtonContent>
</BlazoredToasts>

@code {
    private CancellationTokenSource _cts = new();
    protected override async Task OnInitializedAsync()
    {
        this.appInfoService.ExitApplication += this.ExitApplication;
        deviceHubClient.ChangeNavigation += OnChangeNavigation;
        profileService.UserChanged += this.UserChanged;
        await profileService.LoginAsync(new());


        await base.OnInitializedAsync();
    }

    private void UserChanged(object? sender, UserDto<int, int> user)
    {
        Navigate(this.profileService.CsUser?.Redirect);
    }

    private void OnChangeNavigation(object? sender, string redirect)
    {
        Navigate(redirect);
    }

    private void Navigate(string redirect)
    {
        if (!string.IsNullOrWhiteSpace(redirect)
            && !this._navManager.Uri.Contains(redirect))
        {
            this._navManager.NavigateTo($"{this._navManager.BaseUri}{redirect}");
        }
    }

    private async void ExitApplication(object? sender, bool exit)
    {
        if (!exit)
        {
            await this.clientSettings.ShowToast("Wollen Sie die Anwendung beenden?");
            return;
        }
        this.clientSettings.CloseApp();
    }
    public void Dispose()
    {
        this.appInfoService.ExitApplication -= this.ExitApplication;
        profileService.UserChanged -= this.UserChanged;
        deviceHubClient.ChangeNavigation -= OnChangeNavigation;
        this._cts.Cancel();
    }
}