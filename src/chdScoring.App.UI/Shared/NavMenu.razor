@using chd.UI.Base.Contracts.Enum
@using chdScoring.App.UI.Services;
@inject ISettingManager settingManager

<div class="nav-menu">
    <NavMenuBase Visible="this.Visible">
        <ImageContent>
            <IconButton FAClass="plane" OnClick="()=>this.GoHome()" />
        </ImageContent>
        <MenuContent>
            <NavItem href="" Match="NavLinkMatch.All" IconFAClass="whistle" Title="@PageTitleConstants.Scoring" />
            <AuthorizedNavItem TUserId="int" TRightId="int" Rights="new int[]{RightConstants.AdminId}" href="controlcenter" IconFAClass="calculator" Title="Control Center" />
            <AuthorizedNavItem TUserId="int" TRightId="int" Rights="new int[] { RightConstants.AdminId }" href="correction" IconFAClass="pen-to-square" Title="Score Correction" />
            <AuthorizedNavItem TUserId="int" TRightId="int" Rights="new int[] { RightConstants.AdminId }" href="competitionmanagement" IconFAClass="stopwatch" Title="Competition Management" />
            <AuthorizedNavItem TUserId="int" TRightId="int" Rights="new int[] { RightConstants.AdminId }" Style="EIconStyle.Regular" href="printfiles" IconFAClass="print" Title="Print Files" />
            @if (this._useUix)
            {
                <AuthorizedNavItem TUserId="int" TRightId="int" Rights="new int[] { RightConstants.AdminId }" href="uix" IconFAClass="flask" Title="UI Xperiments" />
            }
        </MenuContent>
        <BottomContent>
            <NavItem Style="EIconStyle.Regular" href="settings" IconFAClass="fa-gear" Title="Settings" />
            <LoginNavItem ModalClass="chd-app-modal-small" TUserId="int" TRightId="int" Style="EIconStyle.Regular" />
        </BottomContent>
    </NavMenuBase>
</div>