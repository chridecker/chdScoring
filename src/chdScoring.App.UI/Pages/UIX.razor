@page "/uix"
@using chdScoring.App.UI.Extensions
@inherits BaseChdScoringPage
@inject INotificationManagerService notificationService
@inject IBatteryService battery
@inject ITTSService ttsService

<div class="notifications">
    <label>Title:</label>
    <input type="text" @bind-value="this._title" />

    <label>Message:</label>
    <input type="text" @bind-value="this._message" />
    <IconButton FAClass="comment" OnClick="this.Alert" />
</div>

<IconButton FAClass="xmark" OnClick="Error" />

<input type="range" min="1" step="1" max="100" value="@_displayBrightness" @onchange="async (e) => await this.UpdateBrightness(e)" />
@this._displayBrightness

@code
{
    private string _title;
    private string _message;

    private float? _displayBrightness;

    protected override async Task OnInitializedAsync()
    {
        this._displayBrightness = _deviceDisplayService.ScreenBrightness;

        this.notificationService.NotificationReceived += this.NotificationReceived;
        this.battery.InfoChanged += this.InfoChanged;
        await base.OnInitializedAsync();
    }
    private async Task UpdateBrightness(ChangeEventArgs e)
    {
        if (float.TryParse(e.Value?.ToString(), out var brightness))
        {
            this._displayBrightness = brightness *0.01f;
            _deviceDisplayService.ScreenBrightness = this._displayBrightness;
        }
    }


    private async Task Error()
    {
        await ttsService.SpeakAsync(_message);
    }

    private async Task Alert()
    {
        await this.modalHandler.ShowYesNoDialog("TEst", false);
        await this.modalHandler.ShowOkCancelDialog("TEst", false);

        this.notificationService.SendNotification(this._title, this._message);
    }

    private async void NotificationReceived(object sender, NotificationEventArgs e)
    {
        await this.modalHandler.ShowSmallDialog(e.Message, chd.UI.Base.Contracts.Enum.EDialogButtons.OK);
    }

    private async void InfoChanged(object sender, EventArgs e)
    {
        await this.InvokeAsync(this.StateHasChanged);
    }
}