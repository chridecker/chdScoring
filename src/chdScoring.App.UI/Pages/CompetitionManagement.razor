@using chd.UI.Base.Client.Implementations.Authorization
@using chd.UI.Base.Components.General
@using chd.UI.Base.Components.General.Pagination
@using chd.UI.Base.Contracts.Enum
@using chdScoring.App.UI.Pages.Components
@using chdScoring.App.UI.Pages.Components.Management
@inherits chd.UI.Base.Components.Base.PageComponentBase<int,int>
@page "/competitionmanagement"
@attribute [chdAuthorize<int>(Rights = new int[] { RightConstants.AdminId })]

<div class="controlcenter-container">

    <Timer CancellationToken="this._cts.Token" Dto="this._dto" Airfield="1" />

    <div class="competition-control">
        <IconButton FAClass="floppy-disk" OnClick="this.SaveRound">Save</IconButton>
        <IconButton FAClass="forward-step" OnClick="async () => await this.LoadNextPilot(true)">Next Pilot</IconButton>
        <IconButton FAClass="forward" OnClick="async () => await this.LoadNextPilot(false)">Choose Pilot</IconButton>
        @if (this._dto is not null)
        {
            <IconButton FAClass="pause" OnClick="this.SetBreak">Break</IconButton>
        }
    </div>
    @if (this._dto is not null)
    {
        <JudgeControl CancellationToken="this._cts.Token" Dto="this._dto" Airfield="1" />
    }
</div>


<FloatingActionNavigation FAIconActive="file-pdf" OnClick="async () => await this.CreatePdf()" TextActive="Create Pdf">

    <FloatingActionButton FAClass="floppy-disks"
                          OnClick="async () => await this.CalculateTBL()"
                          Title="Calculate Round (TBL)"
                          CssClass="dot-btn-save large" />

    <FloatingActionButton FAClass="print"
                          OnClick="async () => await this.PrintPdf()"
                          Title="Manual print existing Pdf"
                          CssClass="dot-btn-save large" />

    <FloatingActionButton FAClass="rotate"
                          OnClick="async () => await this.ChangeStartNumber()"
                          Title="Change StartNumber"
                          CssClass="dot-btn-save large" />

    <FloatingActionButton FAClass="@_autoPrintIco"
                          OnClick="async () => await this.ChangeAutoPrint()"
                          Title="Auto Print"
                          CssClass="dot-btn-save large" />

    <FloatingActionButton FAClass="database"
                          OnClick="async () => await this.LoadDatabaseData()"
                          Title="Choose Database"
                          CssClass="dot-btn-save large" />

    <FloatingActionButton FAClass="arrows-repeat-1"
                          OnClick="async () => await this.ReflightRound()"
                          Title="Reflight"
                          CssClass="dot-btn-save large" />
</FloatingActionNavigation>

