@using chd.UI.Base.Components.General.Search
@using chd.UI.Base.Contracts.Enum
@using chdScoring.App.UI.Extensions
@using chdScoring.App.UI.Pages.Components
@using chdScoring.Contracts.Constants
@using chdScoring.Contracts.Dtos
@using chdScoring.Contracts.Interfaces
@inherits BaseChdScoringPage
@inject IDeviceService deviceService
@page "/devicecontrol"

<div class="devices">
    <Table Items="@_devices" IsSelected="IsCurrent" OnRowClick="SelectRow" HeaderColumns="@(["Host", "X-Api-Key", "Last Update", "User", "Current Site", "Battery", "Charging", "Platform"])">
        <RowTemplate Context="device">
            <TableData>@device.HostName</TableData>
            <TableData>@device.ApiKey</TableData>
            <TableData>@device.LastUpdate.Value.ToString("dd.MM.yyyy HH:mm:ss")</TableData>
            <TableData>@device.User</TableData>
            <TableData>@device.CurrentSite</TableData>
            <TableData>@device.BatteryLevel.ToString("n2")%</TableData>
            <TableData>@device.BatteryCharging</TableData>
            <TableData>@device.Platform</TableData>
        </RowTemplate>
    </Table>
</div>

@if (_current is not null)
{
    <FloatingActionNavigation FAIconActive="arrows-rotate" OnClick="Refresh">
        <FloatingActionButton FAClass="volume" Title="Beep" OnClick="async () => await deviceService.Identify(_current, _token)" />
        <FloatingActionButton FAClass="power-off" Title="Restart" OnClick="async () => await deviceService.ShutDown(_current, true, _token)" />
        <FloatingActionButton FAClass="circle-half-stroke" Title="Toggle Theme" OnClick="async () => await deviceService.ToggleTheme(_current, _token)" />
        <FloatingActionButton FAClass="arrow-right-arrow-left" Title="GoTo" OnClick="async () => await GoTo(false)" />
        <FloatingActionButton FAClass="bolt-auto" Title="Set Redirect" OnClick="async () => await GoTo(true)" />
        <FloatingActionButton FAClass="magnifying-glass" Title="Set Zoom" OnClick="Zoom" />
        <FloatingActionButton FAClass="key" Title="Set ApiKey" OnClick="SetApiKey" />
    </FloatingActionNavigation>
}

@code
{
    DeviceStatusDto _current;
    List<DeviceStatusDto> _devices = [];

    private bool IsCurrent(DeviceStatusDto dto) => _current?.Equals(dto) ?? false;

    protected override async Task OnInitializedAsync()
    {
        await Refresh();
        await base.OnInitializedAsync();
    }

    private async Task Refresh()
    {
        _devices = await deviceService.GetAllAsync(_token);
    }

    private async Task GoTo(bool save)
    {
        var parameters = new ModalParameters
        {
            { nameof(SearchModalComponent<string, int>.Items), ClientRouteConstants.GetConstants().Select(s => s.Value.ToString()) },
            { nameof(SearchModalComponent<string, int>.DisableOrder), true },
        };
        var modalInstance = this.modalHandler.Show<SearchModalComponent<string, int>>($"Gerät {_current.HostName} ({_current.ConnectionId})", parameters);

        var result = await modalInstance.Result;
        if (result.Confirmed && result.Data is string route)
        {
            if (!save)
            {
                await deviceService.NavigateTo(_current, route, _token);
            }
            else
            {
                await deviceService.SetAutoRedirect(_current, route, _token);
            }
        }

        await Refresh();
    }

    private async Task Zoom()
    {
        var parameters = new ModalParameters
        {
            { nameof(SearchModalComponent<int, int>.Items), new int[]{50,60,75,80,90,100,110,125,150,200} },
            { nameof(SearchModalComponent<int, int>.DisableOrder), true },
        };
        var modalInstance = this.modalHandler.Show<SearchModalComponent<int, int>>($"Gerät {_current.HostName} ({_current.ConnectionId})", parameters);

        var result = await modalInstance.Result;
        if (result.Confirmed && result.Data is int zoom)
        {
            await deviceService.SetZoom(_current, zoom, _token);
        }

        await Refresh();
    }
    private async Task SetApiKey()
    {
        var result = await this.modalHandler.ShowSmallInputDialog("", settingManager.IsiOS, "New X-API-KEY");

        if (!string.IsNullOrWhiteSpace(result))
        {
            await deviceService.SetApiKey(_current, result, _token);
        }

        await Refresh();
    }

    private async Task SelectRow(DeviceStatusDto dto, CancellationToken cancellationToken)
    {
        _current = dto;
        await this.InvokeAsync(this.StateHasChanged);
    }
}
