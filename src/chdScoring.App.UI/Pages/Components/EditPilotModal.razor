@using Blazored.Modal.Services
@using chd.UI.Base.Client.Implementations.Services
@using chd.UI.Base.Components.General.Search
@using chd.UI.Base.Contracts.Enum
@using chdScoring.App.UI.Extensions
@using chdScoring.Contracts.Dtos
@using chdScoring.Contracts.Interfaces
<div class="edit-pilot">
    <div class="pilot-section data">
        <div class="label"><CustomIcon FAClass="user" Style="chd.UI.Base.Contracts.Enum.EIconStyle.Regular" /></div>
        <input type="text" @bind-value="this.Pilot.Firstname" placeholder="Vorname" />
        <div class="label"></div>
        <input type="text" @bind-value="this.Pilot.Lastname" placeholder="Nachname" />
        <div class="label"></div>
        <input type="text" @bind-value="this.Pilot.Club" placeholder="Club" />
        <div class="label"></div>
        <input type="text" @bind-value="this.Pilot.License" placeholder="License" />
        <div class="label"></div>
        <div class="country" @onclick="this.ChooseCountry">
            <img src="@($"data:{this.Pilot.CountryImage.Type};base64,{Convert.ToBase64String(Pilot.CountryImage.Data)}")" />
            @this.Pilot.Country
        </div>
    </div>
    <div class="button-section">
        <button class="btn btn-secondary" @onclick="this.Cancel">Abbrechen</button>
        <button class="btn btn-cancel" @onclick="this.Delete">Löschen</button>
        <button class="btn btn-primary" @onclick="this.Save">Speichern</button>
    </div>
</div>


@code {
    [Inject] IPilotService pilotService { get; set; }
    [Inject] IModalHandler modalService { get; set; }
    [Inject] ISettingManager settingManager { get; set; }

    [CascadingParameter] public BlazoredModalInstance ModalInstance { get; set; }
    [Parameter] public bool IsNew { get; set; }
    [Parameter] public PilotDto Pilot { get; set; }

    private Task Save() => this.ModalInstance.CloseAsync(ModalResult.Ok(this.Pilot));

    private Task Cancel() => this.ModalInstance.CancelAsync();


    private async Task Delete()
    {
        if (await this.modalService.ShowYesNoDialog($"Teilnehmer {this.Pilot.Name} löschen?", this.settingManager.IsiOS) is EDialogResult.Yes
        && await pilotService.Delete(this.Pilot))
        {
            await this.ModalInstance.CloseAsync();
        }
    }

    private async Task ChooseCountry()
    {
        var all = await this.pilotService.GetCountries();
        var parameters = new ModalParameters
            {
                { nameof(SearchModalComponent<CountryDto, string>
    .Items),all.OrderBy(o => o.Name)},
    { nameof(SearchModalComponent<CountryDto, string>
        .RenderType),typeof(CountryComponent)},
        { nameof(SearchModalComponent<CountryDto, string>
            .RenderParameterDict),(CountryDto c) =>SearchModalComponent<CountryDto,string>
                .CreateRenderParameterDict(c,((x)=> nameof(CountryComponent.Country),(x)=>x))},
                { nameof(SearchModalComponent<CountryDto, string>
                    .DisableOrder), true },
                    { nameof(SearchModalComponent<CountryDto, string>
                        .Name), (CountryDto dto)=> dto.Name},
                        };
        var modalInstance = this.modalService.Show<SearchModalComponent<CountryDto, string>>("Land auswählen", parameters);

        var result = await modalInstance.Result;
        if (result.Confirmed && result.Data is CountryDto country)
        {
            this.Pilot.CountryId = country.Id;
            this.Pilot.Country = country.Name;
            this.Pilot.CountryImage.Data = Convert.FromBase64String(country.Base64);
            this.Pilot.CountryImage.Type = country.Type;
        }
    }
}
