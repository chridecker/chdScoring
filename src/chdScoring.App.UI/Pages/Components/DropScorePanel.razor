@using chd.UI.Base.Contracts.Enum
@using chdScoring.App.UI.Pages.Components.Base
@inherits ScoreBase

<div class="drop-score-panel">
    <div class="buttons">
        <IconButton FAClass="calculator" OnClick="this.ChangePanelMode" />
    </div>
    <PilotComponent Pilot="this.Pilot" />
    @if (this.PanelDisabled && this.Maneouvre is null && this.NeedsJudgeConfirmation && !this.IsConfirmed)
    {
        <div class="score-confirmation">
            <div class="confirm-text">Please confirm your scores</div>
            <IconButton Disabled="@this.IsConfirmed" FAClass="badge-check" Style="EIconStyle.Regular" OnClick="this.ConfirmScores" />
        </div>
    }
    else if (this.PanelDisabled && this.NeedsJudgeConfirmation && this.IsConfirmed)
    {
        <div class="score-confirmed">
            <CustomIcon FAClass="check-double" Style="EIconStyle.Regular" />
        </div>
    }
    else
    {
        <div class="score-pad">
            <IconButton Disabled="@this.PanelDisabled" FAClass="eye-slash" Style="chd.UI.Base.Contracts.Enum.EIconStyle.Regular" OnClick="async (x) => await this.NotObserved()" />
            <IconButton Disabled="@this.PanelDisabled" FAClass="0" OnClick="this.Zero" />
            <div class="score-control-value">@_scoreValueText</div>
            <IconButton Disabled="@this.PanelDisabled" FAClass="floppy-disk" Style="chd.UI.Base.Contracts.Enum.EIconStyle.Regular" OnClick="Save" />
            
            <IconButton Disabled="@this.PanelDisabled" FAClass="headphones" Style="chd.UI.Base.Contracts.Enum.EIconStyle.Regular" OnClick="this.Repeat" />
        </div>
    }
</div>
