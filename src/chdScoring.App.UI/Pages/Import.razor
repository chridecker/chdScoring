@using chd.UI.Base.Client.Implementations.Authorization
@using chd.UI.Base.Components.General
@using chd.UI.Base.Components.General.Pagination
@using chd.UI.Base.Components.General.Search
@using chd.UI.Base.Contracts.Enum
@using chdScoring.App.UI.Extensions
@using chdScoring.App.UI.Pages.Components
@using chdScoring.App.UI.Pages.Components.Management
@using chdScoring.Contracts.Dtos
@using chdScoring.Contracts.Constants
@using chdScoring.Contracts.Interfaces
@inherits BaseChdScoringPage
@page "/import"
@attribute [chdAuthorize<int>(Rights = new int[] { RightConstants.AdminId })]
@inject IImportService service
@inject IFilePickerService fileService


<div class="import-container">
    <label>Round</label><input type="number" @bind="_dto.Round" />
    <IconButton FAClass="file" OnClick="ChoosePilot">
        @if (_pilotDto is null)
        {
            <text>Choose Pilot</text>
        }
        else
        {
            <NextPilotSearchItem Dto="_pilotDto" />
        }
    </IconButton>
    <IconButton FAClass="file" OnClick="LoadFile">
        @if (string.IsNullOrEmpty(_fileName))
        {
            <text>Load File</text>
        }
        else
        {
            @(_fileName)
        }
    </IconButton>
    <select @bind="_dto.Type">
        <option value="bin" selected>Bin-File</option>
        <option value="json">Json-File</option>
        <option value="json-result">Json-Result-File</option>
    </select>
    <IconButton FAClass="upload" Disabled="@_diableUpload" OnClick="ImportFile">Import File</IconButton>
</div>


@code {
    ImportFileDto _dto = new()
    {
        Round = 1,
        Type = "bin"
    };
    OpenRoundDto _pilotDto;
    string _fileName;

    private bool _diableUpload => string.IsNullOrEmpty(this._fileName) || this._pilotDto is null || this._dto.Round <= 0;

    private async Task ChoosePilot()
    {
        var pilots = await this.pilotService.GetAllPilots(this._token);
        if (!pilots.Any()) { return; }
        var parameters = new ModalParameters
        {
            { nameof(SearchModalComponent<OpenRoundDto, int>.Items), pilots.Select(s => new OpenRoundDto()
            {
                StartNumber = 0,
                Pilot = s,
                Round = 0
            }) },
            { nameof(SearchModalComponent<OpenRoundDto, int>.RenderType),typeof(NextPilotSearchItem) },
            { nameof(SearchModalComponent<OpenRoundDto, int>.RenderParameterDict),(OpenRoundDto dto)=> SearchModalComponent<OpenRoundDto,int>.CreateRenderParameterDict(dto,((x)=> nameof(NextPilotSearchItem.Dto),(x)=>x))},
            { nameof(SearchModalComponent<OpenRoundDto, int>.DisableOrder), true },
        };
        var modalInstance = this.modalHandler.Show<SearchModalComponent<OpenRoundDto, int>>("Pilot", parameters);

        var result = await modalInstance.Result;
        if (result.Confirmed && result.Data is OpenRoundDto dto)
        {
            this._pilotDto = dto;
            this._dto.Pilot = dto.Pilot.Id;
        }
    }

    private async Task ImportFile()
    {
        if (!(await this.GetUploadTask()))
        {
            _ = await this.modalHandler.ShowSmallDialog("Import fehlgeschlagen", EDialogButtons.OK);
        }

        _ = await this.modalHandler.ShowSmallDialog("Import erfolgreich", EDialogButtons.OK);
        this._dto = new()
        {
            Type = "bin",
            Round = this._dto.Round,
            Pilot = this._dto.Pilot
        };
        this._fileName = string.Empty;
    }

    private async Task LoadFile()
    {
        var (fileName, fileData) = await fileService.PickFileAsync(_token);
        this._dto.File = fileData;
        this._fileName = fileName;
    }

    private Task<bool> GetUploadTask() => (this._dto.Type) switch
    {
        "bin" => service.ImportBinFile(this._dto, _token),
        "json" => service.ImportJsonFile(this._dto, _token),
        "json-result" => service.ImportJsonResultFile(this._dto, _token),
        _ => Task.FromResult(false)
    };
}